# Copy to .env and fill in. Never commit .env (it is gitignored).
# Ask Gabriel (or check the team chat) for the shared Supabase + Chroma Cloud values.
# NOTE: Ethan's rag-api-connections branch adds more LLM/audio variables (Hugging Face,
# ElevenLabs) — see that branch's .env.example when the branches are merged.

# ==========================================
# Server
# ==========================================
PORT=3000                         # HTTP port for the Express server

# ==========================================
# LLM provider (owner: Ethan)
# ==========================================
LLM_PROVIDER=groq                 # groq | watsonx | mock — which generator answers chat queries
GROQ_API_KEY=your_groq_api_key_here   # Groq API key (https://console.groq.com)
GROQ_MODEL=llama-3.3-70b-versatile    # Groq model id used for generation

# ==========================================
# IBM watsonx.ai (owner: Ethan) — also used for EMBEDDINGS during ingestion
# Without WATSONX_APIKEY + WATSONX_PROJECT_ID, embeddings fall back to fake hash vectors:
# ingestion still works but semantic search results are meaningless.
# ==========================================
WATSONX_APIKEY=your_ibm_cloud_api_key_here    # IBM Cloud API key
WATSONX_PROJECT_ID=your_watsonx_project_id_here  # watsonx.ai project id
WATSONX_URL=https://us-south.ml.cloud.ibm.com   # watsonx.ai regional endpoint
WATSONX_EMBEDDING_MODEL_ID=ibm/granite-embedding-125m-english  # embedding model (changing it requires a full re-index)
WATSONX_GENERATION_MODEL_ID=ibm/granite-3-8b-instruct          # generation model when LLM_PROVIDER=watsonx

# ==========================================
# PostgreSQL / Supabase (owner: Gabriel)
# Supabase dashboard -> Connect -> "Session pooler" string. NOT "Direct connection" (IPv6-only).
# URL-encode special characters in the password (@ -> %40, | -> %7C, # -> %23).
# ==========================================
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres  # Postgres connection string
# DATABASE_SSL=true               # optional override; SSL is auto-enabled for *.supabase.com hosts

# ==========================================
# ChromaDB vector store (owner: Gabriel)
# If CHROMA_API_KEY is set, Chroma Cloud is used and CHROMADB_URL is ignored.
# ==========================================
CHROMA_API_KEY=                   # Chroma Cloud API key (shared team index)
CHROMA_TENANT=                    # Chroma Cloud tenant id
CHROMA_DATABASE=                  # Chroma Cloud database name (ours: TRACiE)
CHROMADB_URL=http://localhost:8000    # local Chroma server, only used when CHROMA_API_KEY is empty
CHROMA_COLLECTION_NAME=code_chunks    # collection holding code + commit + PR chunks

# ==========================================
# GitHub (owner: Gabriel)
# ==========================================
GITHUB_TOKEN=                     # optional default token: private repos + 5000/h API limit (vs 60/h) for history ingestion
GITHUB_WEBHOOK_SECRET=            # HMAC secret; must equal the "Secret" on the GitHub webhook. Required for /api/webhooks/github
TOKEN_ENCRYPTION_KEY=             # 64 hex chars; encrypts per-repo tokens at rest. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ==========================================
# Ingestion tuning (owner: Gabriel) — defaults shown, all optional
# ==========================================
# INGEST_MAX_CHUNK_CHARS=1500     # max chars per chunk (keep under the embedding model's 512-token limit)
# INGEST_MAX_CHUNK_LINES=60       # max lines per chunk
# INGEST_MAX_FILE_BYTES=307200    # files larger than this are skipped
# INGEST_EMBED_BATCH_SIZE=32      # chunks per embedding request
# INGEST_WORK_DIR=                # where repos are cloned; default <os tmp>/tracie-repos
# INGEST_HISTORY=true             # set false to skip commit/PR ingestion
# HISTORY_MAX_COMMITS=200         # most recent commits to ingest
# HISTORY_MAX_PRS=100             # most recently updated PRs to ingest
