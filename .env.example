# ==========================================
# LLM Provider Selection
# Options: "groq" | "watsonx" | "mock"
# ==========================================
LLM_PROVIDER=groq

# ==========================================
# Groq API Configuration (Fast LPU Engine)
# Get your free key at: https://console.groq.com
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# IBM watsonx.ai Configuration
# ==========================================
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_EMBEDDING_MODEL_ID=ibm/granite-embedding-125m-english
WATSONX_GENERATION_MODEL_ID=ibm/granite-3-8b-instruct

# ==========================================
# ChromaDB Vector Store
# ==========================================
CHROMADB_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=code_chunks
# Chroma Cloud (recommended for the team: one shared index). https://trychroma.com
# When CHROMA_API_KEY is set, the backend uses Chroma Cloud and ignores CHROMADB_URL.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# ==========================================
# Server Configuration
# ==========================================
PORT=3000

# ==========================================
# PostgreSQL (Supabase)  — owner: Gabriel
# Supabase dashboard -> Connect -> "Session pooler" string (IPv4-friendly, port 5432).
# Do NOT use the "Direct connection" string: it is IPv6-only on the free tier.
# Local Postgres also works: postgres://postgres:<password>@localhost:5432/tracie
# ==========================================
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SSL is auto-enabled for *.supabase.com hosts; set true/false to override.
# DATABASE_SSL=true

# ==========================================
# Repository Ingestion  — owner: Gabriel
# ==========================================
# Optional: default GitHub token for cloning (raises rate limits, allows private repos).
# Per-repo tokens can also be sent in POST /api/repos { token }.
GITHUB_TOKEN=
# Required only if repos are connected with a token. 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Tuning (defaults shown). Chunks must stay under the embedding model's 512-token limit.
# INGEST_MAX_CHUNK_CHARS=1500
# INGEST_MAX_CHUNK_LINES=60
# INGEST_MAX_FILE_BYTES=307200
# INGEST_EMBED_BATCH_SIZE=32
# INGEST_WORK_DIR=            # where repos are cloned; defaults to <os tmp>/tracie-repos
